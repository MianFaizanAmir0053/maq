# Copy to .env.local and fill in. On Vercel, add these under Project → Settings → Environment Variables.

# Public URL of the live site (used for the sitemap, robots.txt and social previews).
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Resend API key for emailing form enquiries (resend.com/api-keys). Never commit the real key.
RESEND_API_KEY=

# Inbox that receives enquiries. Leave empty to use the email in lib/site.ts.
# Until a domain is verified in Resend, this must be the Resend account's own address.
ENQUIRY_TO=

# Sender, once maqburgers.com.au is verified in Resend, e.g. MAQ Burgers <website@maqburgers.com.au>.
# Leave empty to use Resend's test sender (onboarding@resend.dev).
RESEND_FROM=
