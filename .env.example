# Copy to .env.local and fill in.

# Public URL of the live site (used for the sitemap, robots.txt and social previews).
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Inbox that receives catering and contact form enquiries (sent via formsubmit.co).
# Leave empty to use the email in lib/site.ts.
ENQUIRY_EMAIL=

# Optional: send enquiries as a JSON POST to this URL instead of by email
# (a Zapier/Make webhook, Slack incoming webhook, your own API...).
ENQUIRY_WEBHOOK_URL=
