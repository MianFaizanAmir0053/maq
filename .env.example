# Copy to .env.local and fill in.

# Public URL of the live site (used for the sitemap, robots.txt and social previews).
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Where catering and contact form submissions are forwarded as a JSON POST
# (Formspree, a Zapier/Make webhook, Slack incoming webhook, your own API...).
# Leave empty to only log submissions on the server.
ENQUIRY_WEBHOOK_URL=
